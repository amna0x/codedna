{
  "private": true,
  "name": "codedna-ide-electron",
  "productName": "CodeDNA IDE",
  "version": "0.1.0",
  "main": "scripts/codedna-electron-main.js",
  "dependencies": {
    "@theia/core": "1.76.0",
    "@theia/editor": "1.76.0",
    "@theia/electron": "1.76.0",
    "@theia/filesystem": "1.76.0",
    "@theia/markers": "1.76.0",
    "@theia/messages": "1.76.0",
    "@theia/monaco": "1.76.0",
    "@theia/navigator": "1.76.0",
    "@theia/plugin-ext": "1.76.0",
    "@theia/plugin-ext-vscode": "1.76.0",
    "@theia/preferences": "1.76.0",
    "@theia/process": "1.76.0",
    "@theia/terminal": "1.76.0",
    "@theia/workspace": "1.76.0",
    "codedna-extension": "0.1.0"
  },
  "devDependencies": {
    "@theia/cli": "1.76.0",
    "electron": "42.8.1",
    "electron-builder": "26.0.12"
  },
  "scripts": {
    "bundle": "npm run rebuild && npm run download:plugins && theia build --mode development",
    "rebuild": "theia rebuild:electron --cacheRoot ..",
    "start": "theia start",
    "watch": "npm run rebuild && theia build --watch --mode development",
    "download:plugins": "theia download:plugins --rate-limit=15 --parallel=false",
    "package": "npm run build:core && npm run build --workspace codedna-extension && npm run rebuild && npm run download:plugins && theia build --mode production && electron-builder --win",
    "build:core": "node scripts/build-core.cjs",
    "test:runtime": "node --test scripts/desktop-runtime.test.cjs scripts/optional-windows-certs.test.mjs"
  },
  "theia": {
    "target": "electron",
    "frontend": {
      "config": {
        "applicationName": "CodeDNA IDE",
        "reloadOnReconnect": true,
        "defaultTheme": "codedna-dark",
        "electron": {
          "appUserModelId": "org.codedna.ide",
          "windowOptions": {
            "backgroundColor": "#191817"
          }
        },
        "preferences": {
          "workbench.colorTheme": "codedna-dark",
          "workbench.iconTheme": "theia-file-icons",
          "editor.fontFamily": "'Geist Mono Variable', 'Cascadia Code', Consolas, monospace",
          "editor.fontSize": 13.5,
          "editor.lineHeight": 21
        }
      }
    }
  },
  "theiaPluginsDir": "plugins",
  "theiaPlugins": {
    "vscode.java": "https://open-vsx.org/api/vscode/java/1.95.3/file/vscode.java-1.95.3.vsix",
    "redhat.java": "https://open-vsx.org/api/redhat/java/win32-x64/1.36.0/file/redhat.java-1.36.0@win32-x64.vsix"
  },
  "description": "CodeDNA Java change-impact analysis, regression test selection and history replay desktop IDE"
}
