{
  "private": true,
  "name": "codedna-ide-electron",
  "productName": "CodeDNA IDE",
  "version": "0.1.0",
  "main": "lib/backend/electron-main.js",
  "dependencies": {
    "@theia/core": "1.76.0",
    "@theia/editor": "1.76.0",
    "@theia/electron": "1.76.0",
    "@theia/filesystem": "1.76.0",
    "@theia/markers": "1.76.0",
    "@theia/messages": "1.76.0",
    "@theia/monaco": "1.76.0",
    "@theia/navigator": "1.76.0",
    "@theia/preferences": "1.76.0",
    "@theia/process": "1.76.0",
    "@theia/terminal": "1.76.0",
    "@theia/workspace": "1.76.0",
    "codedna-extension": "0.1.0"
  },
  "devDependencies": {
    "@theia/cli": "1.76.0",
    "electron": "42.8.1"
  },
  "scripts": {
    "bundle": "npm run rebuild && theia build --mode development",
    "rebuild": "theia rebuild:electron --cacheRoot ..",
    "start": "theia start",
    "watch": "npm run rebuild && theia build --watch --mode development"
  },
  "theia": {
    "target": "electron",
    "frontend": {
      "config": {
        "applicationName": "CodeDNA IDE",
        "reloadOnReconnect": true,
        "defaultTheme": "codedna-dark",
        "electron": {
          "windowOptions": {
            "backgroundColor": "#07090D"
          }
        },
        "preferences": {
          "workbench.colorTheme": "codedna-dark",
          "workbench.iconTheme": "theia-file-icons",
          "editor.fontFamily": "'Geist Mono Variable', 'Cascadia Code', Consolas, monospace",
          "editor.fontSize": 13.5,
          "editor.lineHeight": 21
        }
      }
    }
  }
}
