{"nodes": [{"id": "docs_cross_project_protocol_transfer_protocol", "label": "Cross-Project Transfer Protocol", "file_type": "concept", "source_file": "docs/CROSS_PROJECT_PROTOCOL.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fixed before transfer results were inspected (2026-10-24) to avoid choosing favourable sources or thresholds."}, {"id": "docs_cross_project_protocol_four_project_cohort", "label": "Four-Project Cohort (HikariCP, LittleProxy, jade4j, wicket-bootstrap)", "file_type": "concept", "source_file": "docs/CROSS_PROJECT_PROTOCOL.md", "source_location": "L11", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chosen for recorded failures and small archives that fit a laptop, not for transfer performance; 12 directions plus 4 controls, seeds 0-4."}, {"id": "docs_cross_project_protocol_byte_range_recovery", "label": "HTTP Byte-Range Subset Recovery (fetch_rtptorrent_subset.py)", "file_type": "concept", "source_file": "docs/CROSS_PROJECT_PROTOCOL.md", "source_location": "L23", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Avoids downloading the full 5 GB archive; verifies entry CRCs and records SHA-256 but does not claim the full-archive MD5."}, {"id": "docs_cross_project_protocol_feature_rebuild", "label": "Transfer Feature Rebuild (prepare_transfer_features.py)", "file_type": "concept", "source_file": "docs/CROSS_PROJECT_PROTOCOL.md", "source_location": "L30", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Recovered features must reproduce the original study's dataset hashes before any model runs."}, {"id": "docs_cross_project_protocol_source_prefix_restriction", "label": "Source History Prefix Before Target Test Window", "file_type": "rationale", "source_file": "docs/CROSS_PROJECT_PROTOCOL.md", "source_location": "L40", "source_url": null, "captured_a