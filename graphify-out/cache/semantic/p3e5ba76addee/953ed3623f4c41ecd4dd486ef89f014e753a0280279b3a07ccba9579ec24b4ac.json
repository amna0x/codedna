{"nodes": [{"id": "docs_architecture_codedna_pipeline", "label": "CodeDNA Analysis Pipeline", "file_type": "concept", "source_file": "docs/ARCHITECTURE.md", "source_location": "L3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each stage consumes the previous stage's structured JSON output; the graph UI reads the same JSON so there is no separate graph data source."}, {"id": "docs_architecture_git_change_extractor", "label": "Git Change Extractor (git_analysis.changes)", "file_type": "concept", "source_file": "docs/ARCHITECTURE.md", "source_location": "L112", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Uses git diff -z for NUL-separated unescaped paths; one git call per file is simple and robust but slow for huge diffs."}, {"id": "docs_architecture_run_git_safe_wrapper", "label": "run_git Safe Git Subprocess Wrapper", "file_type": "rationale", "source_file": "docs/ARCHITECTURE.md", "source_location": "L98", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Argument lists with no shell, core.fsmonitor=false and --no-ext-diff --no-textconv stop analysed repositories from launching helper programs; revisions starting with '-' rejected."}, {"id": "docs_architecture_java_declaration_mapper", "label": "Java Declaration Mapper (java_analysis)", "file_type": "concept", "source_file": "docs/ARCHITECTURE.md", "source_location": "L125", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reads raw bytes via git show so line numbering matches git diff; syntax errors make the whole file unresolved rather than partially guessed."}, {"id": "docs_architecture_tree_sitter_java", "label": "Tree-sitter Java Parsing (D-008)", "file_type": "concept", "source_file": "docs/ARCHITECTURE.md", "source_location": "L127", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_syntactic_declaration_ids", "label": "Syntactic Declaration IDs (D-009)", "file_type": "rationale", "source_file": "docs/ARCHITECTURE.md", "source_location": "L133", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Nothing is resolved; IDs use names and parameter types as written, so import-only renames look like delete+add."}, {"id": "docs_architecture_dependency_graph_builder", "label": "Dependency Graph Builder (dependency_graph)", "file_type": "concept", "source_file": "docs/ARCHITECTURE.md", "source_location": "L155", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One git cat-file --batch call and a blob-SHA parse cache keep graph building fast; type-to-type edges only."}, {"id": "docs_architecture_edge_confidence_labels", "label": "Confirmed / Heuristic / Unresolved Edge Labels (D-010)", "file_type": "rationale", "source_file": "docs/ARCHITECTURE.md", "source_location": "L167", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Heuristic relationships must never be claimed as guaranteed dependencies; unresolved names are recorded with reasons instead of guessed."}, {"id": "docs_architecture_unresolved_rate", "label": "Unresolved-Edge Rate Metric", "file_type": "concept", "source_file": "docs/ARCHITECTURE.md", "source_location": "L172", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_change_impact_analyzer", "label": "Change-Impact Analyzer (compute_impact, D-012)", "file_type": "concept", "source_file": "docs/ARCHITECTURE.md", "source_location": "L175", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reverse BFS over merged BASE and HEAD graphs, confirmed edges first; confidence is confirmed only if every edge on the path is."}, {"id": "docs_architecture_test_discovery", "label": "Static JUnit Test Discovery", "file_type": "concept", "source_file": "docs/ARCHITECTURE.md", "source_location": "L193", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_maven_runner", "label": "Opt-in Maven Runner (--allow-build, D-014)", "file_type": "rationale", "source_file": "docs/ARCHITECTURE.md", "source_location": "L199", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Building executes third-party code, so it refuses without explicit allow_build and exports via git archive into an isolated checkout."}, {"id": "docs_architecture_per_test_coverage", "label": "Per-test JaCoCo Coverage Mapping (D-015)", "file_type": "concept", "source_file": "docs/ARCHITECTURE.md", "source_location": "L205", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_selection_baselines", "label": "Selection Baselines: all / dependency / coverage (D-016)", "file_type": "concept", "source_file": "docs/ARCHITECTURE.md", "source_location": "L211", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "compare_strategies evaluates each strategy against ground-truth results.json, measuring missed failures rather than assuming safety."}, {"id": "docs_architecture_plugin_registry", "label": "Language Plugin Registry (codedna.languages, D-024)", "file_type": "concept", "source_file": "docs/ARCHITECTURE.md", "source_location": "L223", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keeps the core language-neutral; incompatible API major versions are skipped and listed in problems."}, {"id": "docs_architecture_java_plugin", "label": "Built-in Java Plugin", "file_type": "concept", "source_file": "docs/ARCHITECTURE.md", "source_location": "L76", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_test_history_store", "label": "Test History Store and Mining (test_history)", "file_type": "concept", "source_file": "docs/ARCHITECTURE.md", "source_location": "L232", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_leakage_guard", "label": "Leakage Guard in build_dataset (D-023)", "file_type": "rationale", "source_file": "docs/ARCHITECTURE.md", "source_location": "L241", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rows are emitted before the commit's outcomes are added to per-test history state, so no future information leaks into features."}, {"id": "docs_architecture_failure_probability_model", "label": "Failure-Probability Model (models)", "file_type": "concept", "source_file": "docs/ARCHITECTURE.md", "source_location": "L27", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_probability_calibration", "label": "Probability Calibration (Platt / isotonic)", "file_type": "concept", "source_file": "docs/ARCHITECTURE.md", "source_location": "L249", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Calibrator fitted on validation split only so calibrated p can be turned into a trustworthy skip-risk estimate."}, {"id": "docs_architecture_risk_aware_selector", "label": "Risk-Aware Test Selector (decide / RiskPolicy)", "file_type": "concept", "source_file": "docs/ARCHITECTURE.md", "source_location": "L259", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Orders by p per estimated second, always keeps changed tests, fills time budget, then broadens until skip risk meets target; unfamiliar commits go to retest-all."}, {"id": "docs_architecture_skip_risk_formula", "label": "Estimated Skip Risk 1 - Prod(1 - p)", "file_type": "rationale", "source_file": "docs/ARCHITECTURE.md", "source_location": "L261", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Assumes